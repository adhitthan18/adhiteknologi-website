# Salin berkas ini menjadi deploy/deploy.env lalu isi sesuai server Anda.
# deploy/deploy.env sudah masuk .gitignore dan tidak akan ikut ter-commit.
#
# Autentikasi memakai kunci SSH, bukan kata sandi. Bila belum dipasang:
#   ssh-keygen -t ed25519 -C "deploy adhiteknologi"
#   ssh-copy-id -p 22 user@ip-server-anda

DEPLOY_HOST=ip-atau-hostname-server
DEPLOY_USER=user-ssh
DEPLOY_PORT=22

# Direktori di server. Rilis aktif berada di $DEPLOY_PATH/app,
# rilis sebelumnya disimpan di $DEPLOY_PATH/previous untuk rollback.
DEPLOY_PATH=/var/www/adhiteknologi

# Nama proses PM2 (harus sama dengan yang ada di ecosystem.config.js)
PM2_APP=adhiteknologi
