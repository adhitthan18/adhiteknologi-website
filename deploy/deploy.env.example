# Salin berkas ini menjadi deploy/deploy.env lalu isi sesuai server Anda.
# deploy/deploy.env sudah masuk .gitignore dan tidak akan ikut ter-commit.
#
# JANGAN menaruh kata sandi di berkas ini. Skrip deploy tidak membacanya dan
# tidak menyimpannya di mana pun — ssh yang akan menanyakannya langsung ke Anda.

DEPLOY_HOST=ssh.example.com
DEPLOY_USER=root
DEPLOY_PORT=22

# Direktori di server. Rilis aktif berada di $DEPLOY_PATH/app,
# rilis sebelumnya disimpan di $DEPLOY_PATH/previous untuk rollback.
DEPLOY_PATH=/var/www/adhiteknologi

# Nama proses PM2 (harus sama dengan yang ada di ecosystem.config.js)
PM2_APP=adhiteknologi

# Port yang didengarkan aplikasi di server. Ganti bila 3000 sudah dipakai
# situs lain di mesin yang sama — sesuaikan juga ecosystem.config.js dan nginx.conf.
APP_PORT=3000

# --- Akses lewat Cloudflare Access ---
# Kosongkan bila terhubung langsung ke server tanpa Cloudflare.
CLOUDFLARED=/c/Users/user/Downloads/Project/iotmaxhub-deploy/.tools/cloudflared.exe

# --- Metode autentikasi ---
#   password : ssh menanyakan kata sandi (satu kali, karena seluruh deploy
#              berjalan dalam satu koneksi)
#   key      : memakai kunci SSH, tanpa interaksi — cocok untuk otomatisasi
SSH_AUTH_MODE=password
