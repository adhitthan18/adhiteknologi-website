# Semua berkas teks disimpan dengan LF di dalam repository.
* text=auto

# Berkas berikut DIEKSEKUSI atau DIBACA di server Linux. Bila ikut dikonversi ke
# CRLF saat checkout di Windows, `git archive` akan mengemasnya dengan CRLF juga,
# dan shebang-nya terbaca sebagai `bash\r` — skrip langsung gagal jalan.
*.sh            text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
*.service       text eol=lf
Dockerfile      text eol=lf
